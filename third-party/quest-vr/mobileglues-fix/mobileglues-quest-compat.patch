+                         GLint dx0, GLint dy0, GLint dx1, GLint dy1,
+                         GLuint logical_read, GLuint logical_draw) noexcept;
+    mg_backend_diagnostic(const mg_backend_diagnostic&) = delete;
+    mg_backend_diagnostic& operator=(const mg_backend_diagnostic&) = delete;
+
+private:
+    bool active_ = false;
+    bool detailed_;
+    unsigned slot_;
+    unsigned error_slot_;
+    unsigned depth_error_slot_ = 0;
+    bool depth_copy_ = false;
+    mg_backend_diag_kind kind_;
