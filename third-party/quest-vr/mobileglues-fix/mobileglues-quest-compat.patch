+        GLES.glGetTexParameteriv(cube_face ? GL_TEXTURE_CUBE_MAP : target, GL_TEXTURE_IMMUTABLE_FORMAT, &immutable);
+        if (immutable) { fail(GL_INVALID_OPERATION); return; }
+    }
+    if (width == 0 || height == 0 || depth == 0) {
