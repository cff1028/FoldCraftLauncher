+#include <cstring>
+#include <new>
+#include <string>
+#include <vector>
+
+#define DEBUG 0
+
+namespace {
+bool drain_errors() {
+    bool clean = true;
+    for (unsigned i = 0; i < 8; ++i) {
+        if (mg_read_backend_error() == GL_NO_ERROR) break;
+        clean = false;
+    }
+    return clean;
+}
+
+bool extension(const char* name) {
+    GLint count = 0;
+    GLES.glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+    for (GLint i = 0; i < count; ++i) {
+        const auto* value = GLES.glGetStringi(GL_EXTENSIONS, i);
+        if (value && std::strcmp(reinterpret_cast<const char*>(value), name) == 0) return true;
+    }
+    return false;
+}
+
+GLenum binding_query(GLenum target) {
+    switch (target) {
+    case GL_TEXTURE_2D: return GL_TEXTURE_BINDING_2D;
+    case GL_TEXTURE_CUBE_MAP: return GL_TEXTURE_BINDING_CUBE_MAP;
+    case GL_TEXTURE_2D_ARRAY: return GL_TEXTURE_BINDING_2D_ARRAY;
+    case GL_TEXTURE_3D: return GL_TEXTURE_BINDING_3D;
+    default: return 0;
+    }
+}
+
+struct saved_state {
+    GLenum target;
+    GLint active = GL_TEXTURE0, texture = 0, sampler = 0, program = 0, vao = 0;
+    GLint read_fbo = 0, draw_fbo = 0, unpack_pbo = 0;
+    GLint polygon_mode[2] = {GL_FILL, GL_FILL};
+    using polygon_mode_fn = void (GLAPIENTRY *)(GLenum, GLenum);
+    polygon_mode_fn polygon = nullptr;
+    std::array<GLint, 4> viewport{}, swizzle{};
+    std::array<GLboolean, 4> color_mask{};
+    std::vector<std::pair<GLenum, GLboolean>> enables;
+    GLboolean blend = GL_FALSE;
+    GLboolean scissor = GL_FALSE;
+    bool indexed_scissor = false;
+    bool indexed = false, tf_paused_by_us = false, changed = false;
+    decltype(GLES.glDisablei) disable_index = nullptr;
+    decltype(GLES.glEnablei) enable_index = nullptr;
+    decltype(GLES.glIsEnabledi) enabled_index = nullptr;
+    decltype(GLES.glColorMaski) mask_index = nullptr;
+
+    explicit saved_state(GLenum target_) : target(target_) {}
+
+    bool capture() {
+        GLES.glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+        if (program != 0) {
+            GLint deleting = GL_FALSE;
+            GLES.glGetProgramiv(program, GL_DELETE_STATUS, &deleting);
+            if (deleting) return false;
+        }
+        for (GLenum query : {GL_ANY_SAMPLES_PASSED, GL_ANY_SAMPLES_PASSED_CONSERVATIVE}) {
+            GLint current = 0;
+            GLES.glGetQueryiv(query, GL_CURRENT_QUERY, &current);
+            if (current != 0) return false;
+        }
+        GLES.glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+        GLES.glGetIntegerv(binding_query(target), &texture);
+        if (texture == 0 || !GLES.glIsTexture(texture)) return false;
+        GLES.glGetIntegerv(GL_SAMPLER_BINDING, &sampler);
+        if (sampler != 0 && !GLES.glIsSampler(sampler)) return false;
+        GLES.glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+        GLES.glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+        GLES.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fbo);
+        GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_pbo);
+        if (unpack_pbo != 0 && !GLES.glIsBuffer(unpack_pbo)) return false;
+        GLES.glGetIntegerv(GL_VIEWPORT, viewport.data());
+        if (g_gles_caps.GL_NV_polygon_mode) {
+            GLES.glGetIntegerv(GL_POLYGON_MODE, polygon_mode);
+            polygon = reinterpret_cast<polygon_mode_fn>(proc_address(gles, "glPolygonModeNV"));
+            if (!polygon && polygon_mode[0] != GL_FILL) return false;
+        }
+        for (unsigned i = 0; i < 4; ++i)
+            GLES.glGetTexParameteriv(target, GL_TEXTURE_SWIZZLE_R + i, &swizzle[i]);
+        const bool core_indexed = g_gles_caps.major > 3 || (g_gles_caps.major == 3 && g_gles_caps.minor >= 2);
+        const char* suffix = extension("GL_EXT_draw_buffers_indexed") ? "EXT"
+                             : extension("GL_OES_draw_buffers_indexed") ? "OES" : nullptr;
+        indexed = core_indexed || suffix;
+        if (indexed) {
+            if (core_indexed) {
+                disable_index = GLES.glDisablei;
+                enable_index = GLES.glEnablei;
+                enabled_index = GLES.glIsEnabledi;
+                mask_index = GLES.glColorMaski;
+            } else {
+                disable_index = reinterpret_cast<decltype(disable_index)>(proc_address(gles, (std::string("glDisablei") + suffix).c_str()));
+                enable_index = reinterpret_cast<decltype(enable_index)>(proc_address(gles, (std::string("glEnablei") + suffix).c_str()));
+                enabled_index = reinterpret_cast<decltype(enabled_index)>(proc_address(gles, (std::string("glIsEnabledi") + suffix).c_str()));
+                mask_index = reinterpret_cast<decltype(mask_index)>(proc_address(gles, (std::string("glColorMaski") + suffix).c_str()));
+            }
+            if (!disable_index || !enable_index || !enabled_index || !mask_index || !GLES.glGetBooleani_v) return false;
+            blend = enabled_index(GL_BLEND, 0);
+            GLES.glGetBooleani_v(GL_COLOR_WRITEMASK, 0, color_mask.data());
+        } else {
+            blend = GLES.glIsEnabled(GL_BLEND);
+            GLES.glGetBooleanv(GL_COLOR_WRITEMASK, color_mask.data());
+        }
+        indexed_scissor = extension("GL_OES_viewport_array") || extension("GL_NV_viewport_array");
+        if (indexed_scissor) {
