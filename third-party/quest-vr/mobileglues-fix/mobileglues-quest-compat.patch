+namespace {
+constexpr GLenum unpack_names[] = {GL_UNPACK_ALIGNMENT, GL_UNPACK_ROW_LENGTH, GL_UNPACK_SKIP_ROWS,
+                                  GL_UNPACK_SKIP_PIXELS, GL_UNPACK_IMAGE_HEIGHT, GL_UNPACK_SKIP_IMAGES};
+
+bool multiply(size_t a, size_t b, size_t& result) {
+    if (b && a > std::numeric_limits<size_t>::max() / b) return false;
+    result = a * b;
+    return true;
+}
+
+bool add(size_t a, size_t b, size_t& result) {
+    if (a > std::numeric_limits<size_t>::max() - b) return false;
+    result = a + b;
+    return true;
+}
+
+size_t component_size(GLenum type) {
+    return type == GL_UNSIGNED_SHORT ? 2 : type == GL_UNSIGNED_INT || type == GL_FLOAT ? 4 : 0;
+}
+
+GLenum upload_type(GLenum storage, GLenum source) {
+    if (storage == GL_DEPTH_COMPONENT32F) return GL_FLOAT;
+    if (storage == GL_DEPTH_COMPONENT16) return source == GL_FLOAT ? GL_UNSIGNED_INT : source;
+    if (storage == GL_DEPTH_COMPONENT24 || storage == GL_DEPTH_COMPONENT) return GL_UNSIGNED_INT;
+    return source;
+}
+
+bool depth_target(GLenum target) {
+    return target == GL_TEXTURE_2D || target == GL_TEXTURE_2D_ARRAY || target == GL_TEXTURE_CUBE_MAP_ARRAY ||
+           (target >= GL_TEXTURE_CUBE_MAP_POSITIVE_X && target <= GL_TEXTURE_CUBE_MAP_NEGATIVE_Z);
+}
+
+double read_depth(const uint8_t* input, GLenum type, bool swap) {
+    uint8_t bytes[4];
+    const size_t size = component_size(type);
+    for (size_t i = 0; i < size; ++i) bytes[i] = input[swap ? size - i - 1 : i];
+    if (type == GL_UNSIGNED_SHORT) {
+        uint16_t value;
+        std::memcpy(&value, bytes, sizeof(value));
+        return static_cast<double>(value) / 65535.0;
+    }
+    if (type == GL_UNSIGNED_INT) {
+        uint32_t value;
+        std::memcpy(&value, bytes, sizeof(value));
+        return static_cast<double>(value) / 4294967295.0;
+    }
+    float value;
+    std::memcpy(&value, bytes, sizeof(value));
+    if (!(value > 0.0f)) return 0.0;
+    return value < 1.0f ? value : 1.0;
+}
+
+void write_depth(uint8_t* output, GLenum type, double value) {
+    if (type == GL_FLOAT) {
+        const float result = static_cast<float>(value);
+        std::memcpy(output, &result, sizeof(result));
+    } else if (type == GL_UNSIGNED_SHORT) {
+        const uint16_t result = static_cast<uint16_t>(std::round(value * 65535.0));
+        std::memcpy(output, &result, sizeof(result));
+    } else {
+        const uint32_t result = static_cast<uint32_t>(std::round(value * 4294967295.0));
+        std::memcpy(output, &result, sizeof(result));
+    }
+}
+}
+
+GLenum mg_depth_level_format(GLenum target, GLint level, GLenum format) {
+    if (format != GL_DEPTH_COMPONENT || !depth_target(target) || level < 0 || !GLES.glGetTexLevelParameteriv) return 0;
+    GLint storage = 0;
+    GLES.glGetTexLevelParameteriv(target, level, GL_TEXTURE_INTERNAL_FORMAT, &storage);
+    return static_cast<GLenum>(storage);
+}
+
+void mg_depth_upload_t::fail(GLenum error) {
+    dropped_ = true;
+    mg_set_gl_error(error);
+}
+
+mg_depth_upload_t::mg_depth_upload_t(GLenum target, GLint level, GLsizei width, GLsizei height, GLsizei depth,
+                                     GLenum format, GLenum source_type, const void* source, GLenum storage,
+                                     bool three_d, bool subimage, GLint x, GLint y, GLint z, GLint border)
+    : type(source_type), pixels(source) {
+    if (format != GL_DEPTH_COMPONENT || !depth_target(target) || component_size(source_type) == 0) return;
+    const bool array = target == GL_TEXTURE_2D_ARRAY || target == GL_TEXTURE_CUBE_MAP_ARRAY;
+    if (three_d != array) return;
+    if (storage != GL_DEPTH_COMPONENT16 && storage != GL_DEPTH_COMPONENT24 && storage != GL_DEPTH_COMPONENT32F &&
+        storage != GL_DEPTH_COMPONENT) return;
+    const GLenum converted_type = upload_type(storage, source_type);
+    const bool swap = mg_unpack_swaps_bytes(source_type);
+    if (converted_type == source_type && !swap) return;
+    GLES.glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer_);
+    if (!source && unpack_buffer_ == 0 && !subimage) return;
+    const bool cube_face = target >= GL_TEXTURE_CUBE_MAP_POSITIVE_X && target <= GL_TEXTURE_CUBE_MAP_NEGATIVE_Z;
+    const bool cube = cube_face || target == GL_TEXTURE_CUBE_MAP_ARRAY;
