+struct mg_shader_defaults_record {
+    std::shared_ptr<const mg_uniform_defaults> source, compiled;
+    bool delete_requested = false;
+};
+
+struct mg_shader_defaults_state {
+    std::mutex mutex;
+    std::unordered_map<GLuint, std::shared_ptr<mg_shader_defaults_record>> shaders;
+};
+
+namespace {
+std::mutex state_mutex;
+
+std::shared_ptr<mg_shader_defaults_state> current_state(bool create = false) {
+    if (!g_current_ctx || !g_current_ctx->share_group) return {};
+    std::lock_guard<std::mutex> lock(state_mutex);
+    auto& state = g_current_ctx->share_group->shader_defaults;
+    if (!state && create) state = std::make_shared<mg_shader_defaults_state>();
+    return state;
+}
+
+bool upload_supported(const mg_uniform_upload& d) {
+    if (!hardware || hardware->es_version < 310) return false;
+    if ((d.base == uniform_base_t::Float) && d.columns == 1) {
+        switch (d.rows) {
+        case 1: return GLES.glProgramUniform1fv != nullptr;
+        case 2: return GLES.glProgramUniform2fv != nullptr;
+        case 3: return GLES.glProgramUniform3fv != nullptr;
+        case 4: return GLES.glProgramUniform4fv != nullptr;
+        default: return false;
+        }
+    }
+    if ((d.base == uniform_base_t::Int || d.base == uniform_base_t::Bool) && d.columns == 1) {
+        switch (d.rows) {
+        case 1: return GLES.glProgramUniform1iv != nullptr;
+        case 2: return GLES.glProgramUniform2iv != nullptr;
+        case 3: return GLES.glProgramUniform3iv != nullptr;
+        case 4: return GLES.glProgramUniform4iv != nullptr;
+        default: return false;
+        }
+    }
+    if ((d.base == uniform_base_t::Uint) && d.columns == 1) {
+        switch (d.rows) {
+        case 1: return GLES.glProgramUniform1uiv != nullptr;
+        case 2: return GLES.glProgramUniform2uiv != nullptr;
+        case 3: return GLES.glProgramUniform3uiv != nullptr;
+        case 4: return GLES.glProgramUniform4uiv != nullptr;
+        default: return false;
+        }
+    }
+    if (d.base != uniform_base_t::Float) return false;
+    switch (d.columns * 10 + d.rows) {
+    case 22: return GLES.glProgramUniformMatrix2fv != nullptr;
+    case 33: return GLES.glProgramUniformMatrix3fv != nullptr;
+    case 44: return GLES.glProgramUniformMatrix4fv != nullptr;
+    case 23: return GLES.glProgramUniformMatrix2x3fv != nullptr;
+    case 32: return GLES.glProgramUniformMatrix3x2fv != nullptr;
+    case 24: return GLES.glProgramUniformMatrix2x4fv != nullptr;
+    case 42: return GLES.glProgramUniformMatrix4x2fv != nullptr;
+    case 34: return GLES.glProgramUniformMatrix3x4fv != nullptr;
+    case 43: return GLES.glProgramUniformMatrix4x3fv != nullptr;
+    default: return false;
+    }
+}
+
+void upload(GLuint program, GLint location, const mg_uniform_upload& d) {
+    if ((d.base == uniform_base_t::Float) && d.columns == 1) {
+        switch (d.rows) {
+        case 1: GLES.glProgramUniform1fv(program, location, d.count, d.floats.data()); return;
+        case 2: GLES.glProgramUniform2fv(program, location, d.count, d.floats.data()); return;
+        case 3: GLES.glProgramUniform3fv(program, location, d.count, d.floats.data()); return;
+        case 4: GLES.glProgramUniform4fv(program, location, d.count, d.floats.data()); return;
+        default: return;
+        }
+    }
+    if ((d.base == uniform_base_t::Int || d.base == uniform_base_t::Bool) && d.columns == 1) {
+        switch (d.rows) {
+        case 1: GLES.glProgramUniform1iv(program, location, d.count, d.integers.data()); return;
+        case 2: GLES.glProgramUniform2iv(program, location, d.count, d.integers.data()); return;
+        case 3: GLES.glProgramUniform3iv(program, location, d.count, d.integers.data()); return;
+        case 4: GLES.glProgramUniform4iv(program, location, d.count, d.integers.data()); return;
+        default: return;
+        }
+    }
+    if ((d.base == uniform_base_t::Uint) && d.columns == 1) {
+        switch (d.rows) {
+        case 1: GLES.glProgramUniform1uiv(program, location, d.count, d.unsigned_integers.data()); return;
+        case 2: GLES.glProgramUniform2uiv(program, location, d.count, d.unsigned_integers.data()); return;
+        case 3: GLES.glProgramUniform3uiv(program, location, d.count, d.unsigned_integers.data()); return;
+        case 4: GLES.glProgramUniform4uiv(program, location, d.count, d.unsigned_integers.data()); return;
+        default: return;
+        }
+    }
+    if (d.base != uniform_base_t::Float) return;
+    switch (d.columns * 10 + d.rows) {
+    case 22: GLES.glProgramUniformMatrix2fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 33: GLES.glProgramUniformMatrix3fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 44: GLES.glProgramUniformMatrix4fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 23: GLES.glProgramUniformMatrix2x3fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 32: GLES.glProgramUniformMatrix3x2fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 24: GLES.glProgramUniformMatrix2x4fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 42: GLES.glProgramUniformMatrix4x2fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 34: GLES.glProgramUniformMatrix3x4fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    case 43: GLES.glProgramUniformMatrix4x3fv(program, location, d.count, GL_FALSE, d.floats.data()); return;
+    default: return;
+    }
+}
+
+bool valid_default(const uniform_default_t& d) {
+    if (d.name.empty() || d.rows < 1 || d.rows > 4 || d.columns < 1 || d.columns > 4 || d.count < 1)
+        return false;
+    if (d.columns > 1 && (d.base != uniform_base_t::Float || d.rows < 2)) return false;
+    const size_t width = static_cast<size_t>(d.rows) * d.columns;
+    if (static_cast<size_t>(d.count) > std::numeric_limits<size_t>::max() / width ||
+        d.values.size() != width * static_cast<size_t>(d.count)) return false;
+    for (const double value : d.values) {
+        if (!std::isfinite(value)) return false;
+        if (d.base == uniform_base_t::Float) continue;
+        if (std::trunc(value) != value) return false;
+        if (d.base == uniform_base_t::Uint) {
+            if (value < 0 || value > std::numeric_limits<GLuint>::max()) return false;
+        } else if (value < std::numeric_limits<GLint>::min() || value > std::numeric_limits<GLint>::max()) return false;
+    }
+    return true;
+}
+}
+
+mg_shader_defaults_update mg_prepare_shader_defaults(GLuint shader, mg_uniform_defaults values) {
+    mg_shader_defaults_update update;
+    update.state = current_state(true);
+    if (!update.state) return update;
+    if (!values.empty()) update.values = std::make_shared<const mg_uniform_defaults>(std::move(values));
+    std::lock_guard<std::mutex> lock(update.state->mutex);
+    auto it = update.state->shaders.find(shader);
+    if (it == update.state->shaders.end())
+        it = update.state->shaders.emplace(shader, std::make_shared<mg_shader_defaults_record>()).first;
+    update.record = it->second;
+    return update;
+}
+
+void mg_commit_shader_defaults(const mg_shader_defaults_update& update) {
+    if (!update.record) return;
+    std::lock_guard<std::mutex> lock(update.state->mutex);
+    update.record->source = update.values;
+}
+
+mg_shader_defaults_update mg_snapshot_shader_defaults(GLuint shader) {
+    mg_shader_defaults_update update;
+    update.state = current_state();
+    if (!update.state) return update;
+    std::lock_guard<std::mutex> lock(update.state->mutex);
+    const auto it = update.state->shaders.find(shader);
+    if (it != update.state->shaders.end()) {
+        update.record = it->second;
+        update.values = update.record->source;
+    }
+    return update;
+}
+
+void mg_commit_compiled_defaults(const mg_shader_defaults_update& update) {
+    if (!update.record) return;
+    std::lock_guard<std::mutex> lock(update.state->mutex);
+    update.record->compiled = update.values;
+}
+
+void mg_forget_shader_defaults(GLuint shader) {
+    const auto state = current_state();
+    if (!state) return;
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->shaders.erase(shader);
+}
+
+void mg_delete_shader_defaults(GLuint shader) {
+    const auto state = current_state();
+    if (!state) return;
+    std::lock_guard<std::mutex> lock(state->mutex);
+    const auto it = state->shaders.find(shader);
+    if (it == state->shaders.end()) return;
+    if (GLES.glIsShader(shader)) it->second->delete_requested = true;
+    else state->shaders.erase(it);
+}
+
+void mg_collect_shader_defaults() {
+    const auto state = current_state();
+    if (!state) return;
+    std::lock_guard<std::mutex> lock(state->mutex);
+    for (auto it = state->shaders.begin(); it != state->shaders.end();) {
+        if (it->second->delete_requested && !GLES.glIsShader(it->first)) it = state->shaders.erase(it);
+        else ++it;
+    }
+}
+
+mg_program_defaults mg_prepare_program_defaults(GLuint program) {
+    mg_program_defaults prepared;
+    const auto state = current_state();
+    if (!state || !GLES.glIsProgram(program)) return prepared;
+    GLint count = 0;
+    GLES.glGetProgramiv(program, GL_ATTACHED_SHADERS, &count);
+    if (count <= 0) return prepared;
+    std::vector<GLuint> shaders(static_cast<size_t>(count));
+    GLsizei attached = 0;
+    GLES.glGetAttachedShaders(program, count, &attached, shaders.data());
+    std::vector<std::shared_ptr<const mg_uniform_defaults>> snapshots;
+    {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        for (GLsizei i = 0; i < attached && i < count; ++i) {
+            const auto it = state->shaders.find(shaders[i]);
+            if (it != state->shaders.end() && it->second->compiled) snapshots.push_back(it->second->compiled);
+        }
+    }
+    for (const auto& snapshot : snapshots) {
+        for (const auto& d : *snapshot) {
+            if (!valid_default(d)) continue;
+            mg_uniform_upload item;
+            item.name = d.name;
+            item.array_name = d.name + "[0]";
+            item.base = d.base;
+            item.rows = d.rows;
+            item.columns = d.columns;
+            item.count = d.count;
+            if (d.base == uniform_base_t::Float) item.floats.assign(d.values.begin(), d.values.end());
+            else if (d.base == uniform_base_t::Uint) item.unsigned_integers.assign(d.values.begin(), d.values.end());
+            else item.integers.assign(d.values.begin(), d.values.end());
+            if (!upload_supported(item)) prepared.supported = false;
+            prepared.uploads.push_back(std::move(item));
+        }
+    }
+    return prepared;
+}
+
+void mg_apply_program_defaults(GLuint program, const mg_program_defaults& defaults) {
+    if (defaults.uploads.empty() || !defaults.supported || !GLES.glIsProgram(program)) return;
+    GLint linked = GL_FALSE;
+    GLES.glGetProgramiv(program, GL_LINK_STATUS, &linked);
+    if (linked != GL_TRUE) return;
+    for (const auto& item : defaults.uploads) {
+        GLint location = GLES.glGetUniformLocation(program, item.name.c_str());
+        if (location < 0) location = GLES.glGetUniformLocation(program, item.array_name.c_str());
+        if (location >= 0) upload(program, location, item);
+    }
+}
