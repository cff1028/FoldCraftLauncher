+        input = static_cast<const uint8_t*>(GLES.glMapBufferRange(GL_COPY_WRITE_BUFFER, 0, static_cast<GLsizeiptr>(span), GL_MAP_READ_BIT));
+        if (!input) { fail(GL_INVALID_OPERATION); return; }
+    }
+    uint8_t* output = data_.data();
+    for (GLsizei layer = 0; layer < depth; ++layer) {
+        for (GLsizei row = 0; row < height; ++row) {
+            const uint8_t* pixel = input + start + static_cast<size_t>(layer) * image_stride + static_cast<size_t>(row) * row_stride;
+            for (GLsizei column = 0; column < width; ++column) {
+                write_depth(output, converted_type, read_depth(pixel, source_type, swap));
+                output += output_size;
+                pixel += input_size;
+            }
+        }
+    }
+    if (scratch_buffer_ && !GLES.glUnmapBuffer(GL_COPY_WRITE_BUFFER)) { fail(GL_INVALID_OPERATION); return; }
+    if (unpack_buffer_ != 0) GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    for (size_t i = 0; i < 6; ++i) GLES.glPixelStorei(unpack_names[i], i == 0 ? 1 : 0);
+    changed_unpack_ = true;
+    type = converted_type;
+    pixels = data_.data();
+}
+
+mg_depth_upload_t::~mg_depth_upload_t() {
+    if (changed_unpack_) {
+        for (size_t i = 0; i < 6; ++i) GLES.glPixelStorei(unpack_names[i], unpack_[i]);
+        if (unpack_buffer_ != 0) GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, static_cast<GLuint>(unpack_buffer_));
+    }
+    if (scratch_buffer_) {
+        GLES.glBindBuffer(GL_COPY_WRITE_BUFFER, static_cast<GLuint>(copy_write_));
+        GLES.glDeleteBuffers(1, &scratch_buffer_);
+    }
+}
