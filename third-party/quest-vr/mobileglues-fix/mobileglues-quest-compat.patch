+        } else {
+            enables.emplace_back(GL_SCISSOR_TEST, GLES.glIsEnabled(GL_SCISSOR_TEST));
+        }
+        for (GLenum cap : {GL_DEPTH_TEST, GL_STENCIL_TEST, GL_CULL_FACE,
+                           GL_RASTERIZER_DISCARD, GL_DITHER, GL_SAMPLE_COVERAGE, GL_SAMPLE_ALPHA_TO_COVERAGE})
+            enables.emplace_back(cap, GLES.glIsEnabled(cap));
+        if (g_gles_caps.major > 3 || (g_gles_caps.major == 3 && g_gles_caps.minor >= 1))
+            enables.emplace_back(GL_SAMPLE_MASK, GLES.glIsEnabled(GL_SAMPLE_MASK));
+        if (g_gles_caps.GL_EXT_sRGB_write_control)
+            enables.emplace_back(GL_FRAMEBUFFER_SRGB, GLES.glIsEnabled(GL_FRAMEBUFFER_SRGB));
+        if (g_gles_caps.GL_EXT_clip_cull_distance || core_indexed) {
+            GLint count = 0;
+            GLES.glGetIntegerv(GL_MAX_CLIP_DISTANCES, &count);
+            for (GLint i = 0; i < std::min(count, 8); ++i)
+                enables.emplace_back(GL_CLIP_DISTANCE0 + i, GLES.glIsEnabled(GL_CLIP_DISTANCE0 + i));
+        }
+        return drain_errors();
+    }
+
+    void prepare() {
+        changed = true;
+        GLboolean tf_active = GL_FALSE, tf_paused = GL_FALSE;
+        GLES.glGetBooleanv(GL_TRANSFORM_FEEDBACK_ACTIVE, &tf_active);
+        GLES.glGetBooleanv(GL_TRANSFORM_FEEDBACK_PAUSED, &tf_paused);
+        if (tf_active && !tf_paused) {
+            GLES.glPauseTransformFeedback();
+            tf_paused_by_us = true;
+        }
+        for (const auto& [cap, enabled] : enables) {
+            if (cap == GL_FRAMEBUFFER_SRGB) GLES.glEnable(cap);
+            else GLES.glDisable(cap);
+        }
+        if (indexed) {
+            disable_index(GL_BLEND, 0);
+            mask_index(0, GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        } else {
+            GLES.glDisable(GL_BLEND);
+            GLES.glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        }
+        if (indexed_scissor) disable_index(GL_SCISSOR_TEST, 0);
+        GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+        if (polygon) polygon(GL_FRONT_AND_BACK, GL_FILL);
+        const GLenum defaults[] = {GL_RED, GL_GREEN, GL_BLUE, GL_ALPHA};
+        for (unsigned i = 0; i < 4; ++i) GLES.glTexParameteri(target, GL_TEXTURE_SWIZZLE_R + i, defaults[i]);
+    }
+
+    ~saved_state() {
+        if (!changed) return;
+        GLES.glActiveTexture(active);
+        GLES.glBindTexture(target, texture);
+        for (unsigned i = 0; i < 4; ++i) GLES.glTexParameteri(target, GL_TEXTURE_SWIZZLE_R + i, swizzle[i]);
+        GLES.glBindSampler(active - GL_TEXTURE0, sampler);
+        GLES.glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_pbo);
+        GLES.glUseProgram(program);
+        GLES.glBindVertexArray(vao);
+        GLES.glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+        GLES.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw_fbo);
+        GLES.glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+        if (polygon) polygon(GL_FRONT_AND_BACK, polygon_mode[0]);
+        for (const auto& [cap, enabled] : enables) {
+            if (enabled) GLES.glEnable(cap);
+            else GLES.glDisable(cap);
+        }
+        if (indexed) {
+            if (blend) enable_index(GL_BLEND, 0);
+            else disable_index(GL_BLEND, 0);
+            mask_index(0, color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+        } else {
+            if (blend) GLES.glEnable(GL_BLEND);
+            else GLES.glDisable(GL_BLEND);
+            GLES.glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+        }
+        if (indexed_scissor) {
+            if (scissor) enable_index(GL_SCISSOR_TEST, 0);
+            else disable_index(GL_SCISSOR_TEST, 0);
+        }
+        if (tf_paused_by_us) GLES.glResumeTransformFeedback();
+    }
+};
+
+struct resources {
+    GLuint texture = 0, fbo = 0, vao = 0, sampler = 0, program = 0, vertex = 0, fragment = 0;
+    ~resources() {
+        if (texture) GLES.glDeleteTextures(1, &texture);
+        if (fbo) GLES.glDeleteFramebuffers(1, &fbo);
+        if (vao) GLES.glDeleteVertexArrays(1, &vao);
+        if (sampler) GLES.glDeleteSamplers(1, &sampler);
+        if (program) GLES.glDeleteProgram(program);
+        if (vertex) GLES.glDeleteShader(vertex);
+        if (fragment) GLES.glDeleteShader(fragment);
+    }
+};
+
+bool compile(GLuint shader, const char* source) {
+    GLES.glShaderSource(shader, 1, &source, nullptr);
+    GLES.glCompileShader(shader);
+    GLint ready = GL_FALSE;
+    GLES.glGetShaderiv(shader, GL_COMPILE_STATUS, &ready);
+    return ready == GL_TRUE;
+}
+
+bool make_program(resources& r, GLenum target) {
+    const char* vertex = R"(#version 300 es
+precision highp float;
+out vec2 uv;
+void main() {
+    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+    uv = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+})";
+    const char* type = target == GL_TEXTURE_2D ? "sampler2D" : target == GL_TEXTURE_CUBE_MAP ? "samplerCube"
+                       : target == GL_TEXTURE_2D_ARRAY ? "sampler2DArray" : "sampler3D";
+    std::string fragment = "#version 300 es\nprecision highp float;\nprecision highp " + std::string(type) +
+        ";\nin vec2 uv;\nuniform " + type + " source;\nuniform float layer;\nlayout(location=0) out vec4 color;\n";
+    if (target == GL_TEXTURE_CUBE_MAP) {
+        fragment += R"(vec3 coord() {
+    vec2 p = uv * 2.0 - 1.0;
+    if (layer < 0.5) return vec3(1.0, -p.y, -p.x);
+    if (layer < 1.5) return vec3(-1.0, -p.y, p.x);
+    if (layer < 2.5) return vec3(p.x, 1.0, p.y);
+    if (layer < 3.5) return vec3(p.x, -1.0, -p.y);
+    if (layer < 4.5) return vec3(p.x, -p.y, 1.0);
+    return vec3(-p.x, -p.y, -1.0);
+}
+)";
+    }
+    const char* coord = target == GL_TEXTURE_2D ? "uv" : target == GL_TEXTURE_CUBE_MAP ? "coord()" : "vec3(uv, layer)";
+    fragment += "void main() { color = vec4(textureLod(source, " + std::string(coord) + ", 0.0).rgb, 1.0); }\n";
+    r.vertex = GLES.glCreateShader(GL_VERTEX_SHADER);
+    r.fragment = GLES.glCreateShader(GL_FRAGMENT_SHADER);
+    if (!r.vertex || !r.fragment || !compile(r.vertex, vertex) || !compile(r.fragment, fragment.c_str())) return false;
+    r.program = GLES.glCreateProgram();
+    GLES.glAttachShader(r.program, r.vertex);
+    GLES.glAttachShader(r.program, r.fragment);
+    GLES.glLinkProgram(r.program);
+    GLint ready = GL_FALSE;
+    GLES.glGetProgramiv(r.program, GL_LINK_STATUS, &ready);
+    return ready == GL_TRUE && drain_errors();
+}
+
+void attach_slice(GLenum target, GLuint texture, GLint level, GLint slice) {
+    if (target == GL_TEXTURE_2D || target == GL_TEXTURE_CUBE_MAP) {
+        const GLenum face = target == GL_TEXTURE_CUBE_MAP ? GL_TEXTURE_CUBE_MAP_POSITIVE_X + slice : target;
+        GLES.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, face, texture, level);
+    } else {
+        GLES.glFramebufferTextureLayer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, texture, level, slice);
+    }
+}
+
+void allocate_level(GLenum target, GLint level, GLenum format, GLsizei width, GLsizei height, GLsizei depth) {
+    if (target == GL_TEXTURE_CUBE_MAP) {
+        for (unsigned i = 0; i < 6; ++i)
+            GLES.glTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X + i, level, format, width, height, 0,
+                              format == GL_SRGB8 ? GL_RGB : GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    } else if (target == GL_TEXTURE_2D) {
+        GLES.glTexImage2D(target, level, format, width, height, 0,
+                          format == GL_SRGB8 ? GL_RGB : GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    } else {
+        GLES.glTexImage3D(target, level, format, width, height, depth, 0,
+                          format == GL_SRGB8 ? GL_RGB : GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    }
+}
+
+bool generate(GLenum target, GLint base, GLint last, GLint width, GLint height, GLint depth, bool immutable) {
+    GLint viewport_limit[2] = {};
+    GLES.glGetIntegerv(GL_MAX_VIEWPORT_DIMS, viewport_limit);
+    if (width > viewport_limit[0] || height > viewport_limit[1]) return false;
+    resources r;
+    saved_state state(target);
+    if (!state.capture()) return false;
+    if (!make_program(r, target)) return false;
+    state.prepare();
+    GLES.glGenTextures(1, &r.texture);
+    GLES.glGenFramebuffers(1, &r.fbo);
+    GLES.glGenVertexArrays(1, &r.vao);
+    GLES.glGenSamplers(1, &r.sampler);
+    if (!r.texture || !r.fbo || !r.vao || !r.sampler) return false;
+    GLES.glSamplerParameteri(r.sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    GLES.glSamplerParameteri(r.sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    GLES.glSamplerParameteri(r.sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    GLES.glSamplerParameteri(r.sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    GLES.glSamplerParameteri(r.sampler, GL_TEXTURE_WRAP_R, GL_CLAMP_TO_EDGE);
+    GLES.glBindSampler(state.active - GL_TEXTURE0, r.sampler);
+    GLES.glBindTexture(target, r.texture);
+    allocate_level(target, 0, GL_SRGB8_ALPHA8, width, height, depth);
+    GLES.glTexParameteri(target, GL_TEXTURE_MAX_LEVEL, last - base);
+    GLES.glBindFramebuffer(GL_FRAMEBUFFER, r.fbo);
+    const GLenum attachment = GL_COLOR_ATTACHMENT0;
+    GLES.glDrawBuffers(1, &attachment);
+    GLES.glReadBuffer(GL_COLOR_ATTACHMENT0);
+    GLES.glBindVertexArray(r.vao);
+    GLES.glUseProgram(r.program);
+    GLES.glUniform1i(GLES.glGetUniformLocation(r.program, "source"), state.active - GL_TEXTURE0);
+    const GLint layer_location = GLES.glGetUniformLocation(r.program, "layer");
+    GLES.glBindTexture(target, state.texture);
+    GLES.glViewport(0, 0, width, height);
+    if (!drain_errors()) return false;
+    const GLint slices = target == GL_TEXTURE_CUBE_MAP ? 6 : depth;
+    for (GLint slice = 0; slice < slices; ++slice) {
+        attach_slice(target, r.texture, 0, slice);
+        if (GLES.glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) return false;
+        GLES.glUniform1f(layer_location, target == GL_TEXTURE_3D ? (slice + 0.5f) / depth : static_cast<float>(slice));
+        GLES.glDrawArrays(GL_TRIANGLES, 0, 3);
+        if (!drain_errors()) return false;
+    }
+    GLES.glBindTexture(target, r.texture);
+    GLES.glGenerateMipmap(target);
+    if (!drain_errors()) return false;
+    GLES.glBindTexture(target, state.texture);
+    for (GLint level = base + 1; level <= last; ++level) {
+        width = std::max(1, width / 2);
+        height = std::max(1, height / 2);
+        if (target == GL_TEXTURE_3D) depth = std::max(1, depth / 2);
+        if (!immutable) allocate_level(target, level, GL_SRGB8, width, height, depth);
+        if (!drain_errors()) return false;
+        const GLint count = target == GL_TEXTURE_CUBE_MAP ? 6 : depth;
+        for (GLint slice = 0; slice < count; ++slice) {
+            attach_slice(target, r.texture, level - base, slice);
+            if (GLES.glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) return false;
+            if (target == GL_TEXTURE_2D || target == GL_TEXTURE_CUBE_MAP) {
+                const GLenum face = target == GL_TEXTURE_CUBE_MAP ? GL_TEXTURE_CUBE_MAP_POSITIVE_X + slice : target;
+                GLES.glCopyTexSubImage2D(face, level, 0, 0, 0, 0, width, height);
+            } else {
+                GLES.glCopyTexSubImage3D(target, level, 0, 0, slice, 0, 0, width, height);
+            }
+            if (!drain_errors()) return false;
+        }
+    }
+    return true;
+}
+} // namespace
+
+bool generate_srgb_mipmap(GLenum target) {
+    if (g_gles_caps.major < 3 || (g_gles_caps.major == 3 && g_gles_caps.minor < 1)) return false;
+    if (!binding_query(target) || !GLES.glGetTexLevelParameteriv) return false;
+    GLint base = 0, maximum = 0, immutable = GL_FALSE, levels = 0;
+    GLES.glGetTexParameteriv(target, GL_TEXTURE_BASE_LEVEL, &base);
+    GLES.glGetTexParameteriv(target, GL_TEXTURE_MAX_LEVEL, &maximum);
+    GLES.glGetTexParameteriv(target, GL_TEXTURE_IMMUTABLE_FORMAT, &immutable);
+    if (immutable) {
+        GLES.glGetTexParameteriv(target, GL_TEXTURE_IMMUTABLE_LEVELS, &levels);
+        base = std::min(base, std::max(0, levels - 1));
+        maximum = std::min(maximum, levels - 1);
+    }
+    GLint texture_limit = 0, max_base = 0;
+    GLES.glGetIntegerv(target == GL_TEXTURE_CUBE_MAP ? GL_MAX_CUBE_MAP_TEXTURE_SIZE
+                       : target == GL_TEXTURE_3D ? GL_MAX_3D_TEXTURE_SIZE : GL_MAX_TEXTURE_SIZE, &texture_limit);
+    while (texture_limit > 1) { texture_limit /= 2; ++max_base; }
+    if (base < 0 || base > max_base) return false;
+    const GLenum image_target = target == GL_TEXTURE_CUBE_MAP ? GL_TEXTURE_CUBE_MAP_POSITIVE_X : target;
+    GLint format = 0, width = 0, height = 0, depth = 1;
+    GLES.glGetTexLevelParameteriv(image_target, base, GL_TEXTURE_INTERNAL_FORMAT, &format);
+    if (format != GL_SRGB8) return false;
+    drain_errors();
+    GLES.glGetTexLevelParameteriv(image_target, base, GL_TEXTURE_WIDTH, &width);
+    GLES.glGetTexLevelParameteriv(image_target, base, GL_TEXTURE_HEIGHT, &height);
+    if (target == GL_TEXTURE_3D || target == GL_TEXTURE_2D_ARRAY)
+        GLES.glGetTexLevelParameteriv(image_target, base, GL_TEXTURE_DEPTH, &depth);
+    if (!drain_errors()) return true;
+    if (target == GL_TEXTURE_CUBE_MAP) {
+        for (unsigned i = 0; i < 6; ++i) {
+            GLint w = 0, h = 0, f = 0;
+            GLES.glGetTexLevelParameteriv(GL_TEXTURE_CUBE_MAP_POSITIVE_X + i, base, GL_TEXTURE_WIDTH, &w);
+            GLES.glGetTexLevelParameteriv(GL_TEXTURE_CUBE_MAP_POSITIVE_X + i, base, GL_TEXTURE_HEIGHT, &h);
+            GLES.glGetTexLevelParameteriv(GL_TEXTURE_CUBE_MAP_POSITIVE_X + i, base, GL_TEXTURE_INTERNAL_FORMAT, &f);
+            if (width <= 0 || w != width || h != width || f != GL_SRGB8) {
+                mg_set_gl_error(GL_INVALID_OPERATION);
+                return true;
+            }
+        }
+    }
+    if (width == 0 || height == 0 || depth == 0) return true;
+    GLint last = base;
+    GLint dimension = std::max(width, height);
+    if (target == GL_TEXTURE_3D) dimension = std::max(dimension, depth);
+    while (dimension > 1 && last < maximum) {
+        dimension /= 2;
+        ++last;
+    }
+    if (last <= base) return true;
+    if (!generate(target, base, last, width, height, depth, immutable != GL_FALSE)) {
+        mg_set_gl_error(GL_INVALID_OPERATION);
+        LOG_W_FORCE("SRGB8 mipmap fallback failed: target=0x%x base=%d last=%d size=%dx%dx%d", target, base, last, width, height, depth)
+    }
+    return true;
+}
+
+bool mg_generate_srgb_mipmap(GLenum target) {
+    try {
+        return generate_srgb_mipmap(target);
+    } catch (const std::bad_alloc&) {
+        mg_set_gl_error(GL_OUT_OF_MEMORY);
+    } catch (...) {
+        mg_set_gl_error(GL_INVALID_OPERATION);
+    }
+    return true;
+}
