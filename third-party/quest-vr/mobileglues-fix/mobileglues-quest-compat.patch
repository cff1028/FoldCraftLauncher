+// Modified for FCL Quest VR on 2026-11-13: bounded per-model VRM and mip diagnostics.
+// Copyright (c) 2026 FCL Quest contributors
+// SPDX-License-Identifier: LGPL-2.1-only
+#include "vrm_diagnostics.h"
+#include "framebuffer.h"
+#include "log.h"
+#include "../gles/loader.h"
+#include "../egl/context.h"
+#include <atomic>
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <tuple>
+#include <vector>
+
+#define DEBUG 0
+
+namespace {
+std::atomic<unsigned> samples{0};
+std::atomic<bool> stopped{false};
+constexpr unsigned limit = 512, model_limit = 24;
+constexpr size_t byte_limit = 4 * 1024 * 1024;
+constexpr uint64_t idle_ms = 30000;
+std::mutex output_mutex;
+size_t output_bytes = 0;
+
+void budget_notice(const char* reason) noexcept {
+    std::lock_guard<std::mutex> lock(output_mutex);
+    if (stopped.exchange(true, std::memory_order_relaxed)) return;
+    LOG_V("[MG-VRM] budget=%s capture-stopped samples=%u", reason, samples.load(std::memory_order_relaxed));
+}
+
+void record(const char* format, ...) noexcept {
+    char line[2048];
+    va_list args;
+    va_start(args, format);
+    const int length = std::vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    if (length < 0) return;
+    const size_t bytes = std::min(static_cast<size_t>(length), sizeof(line) - 1) + 1;
+    bool full = false;
+    {
+        std::lock_guard<std::mutex> lock(output_mutex);
+        if (stopped.load(std::memory_order_relaxed)) return;
+        full = output_bytes + bytes > byte_limit - 128;
+        if (!full) {
+            output_bytes += bytes;
+            LOG_V("%s", line);
+        }
+    }
+    if (full) budget_notice("4MiB");
+}
+
+struct draw_signature {
+    GLuint program = 0, vao = 0;
+    std::array<GLint, 8> modes{};
+    std::array<uint32_t, 7> colors{};
+    std::array<GLint, 11> units{}, textures{}, samplers{};
+    bool operator==(const draw_signature&) const = default;
+};
+
+struct model_samples {
+    uint64_t last_seen = 0;
+    std::array<unsigned, 2> counts{};
+    std::array<bool, 2> notified{};
+    std::vector<draw_signature> signatures;
+};
+
+struct sampling_gate {
+    std::map<std::tuple<uint64_t, GLuint, GLuint>, model_samples> models;
+    unsigned total = 0;
+
+    unsigned claim(uint64_t context, const draw_signature& key, uint64_t now, bool& capped) {
+        capped = false;
+        if (total >= limit) return 0;
+        auto& model = models[{context, key.program, key.vao}];
+        // Without deletion hooks, a quiet interval is only a name-reuse heuristic.
+        if (now - model.last_seen >= idle_ms) model = {};
+        model.last_seen = now;
+        const unsigned state = key.modes[0] != 0;
+        if (std::find(model.signatures.begin(), model.signatures.end(), key) != model.signatures.end()) return 0;
+        if (model.counts[state] >= model_limit) {
+            capped = !model.notified[state];
+            model.notified[state] = true;
+            return 0;
+        }
+        model.signatures.push_back(key);
+        ++model.counts[state];
+        return ++total;
+    }
+};
+
+sampling_gate gate;
+std::mutex gate_mutex;
+
+bool enabled() noexcept {
+    static const bool value = [] {
+        const char* setting = std::getenv("MG_VRM_DIAGNOSTICS");
+        return setting && std::strcmp(setting, "1") == 0;
+    }();
+    return value;
+}
+
+GLint integer(GLenum name) noexcept {
+    GLint value = 0;
+    GLES.glGetIntegerv(name, &value);
+    return value;
+}
+
+struct active_texture_scope {
+    GLint saved = integer(GL_ACTIVE_TEXTURE);
+    ~active_texture_scope() { GLES.glActiveTexture(saved); }
+};
+
+struct copy_read_scope {
+    GLint saved = integer(GL_COPY_READ_BUFFER_BINDING);
+    ~copy_read_scope() { GLES.glBindBuffer(GL_COPY_READ_BUFFER, saved); }
+};
+
+GLint uniform_int(GLuint program, const char* name, GLint missing = 0) noexcept {
+    const GLint location = GLES.glGetUniformLocation(program, name);
+    if (location < 0) return missing;
+    GLint values[16] = {};
+    GLES.glGetUniformiv(program, location, values);
+    return values[0];
+}
+
+void float_uniform(GLuint program, const char* name, unsigned sample) noexcept {
+    const GLint location = GLES.glGetUniformLocation(program, name);
+    if (location < 0) return;
+    GLfloat value[16] = {};
+    GLES.glGetUniformfv(program, location, value);
+    record("[MG-VRM] sample=%u uniform=%s f=%g,%g,%g,%g", sample, name,
+           value[0], value[1], value[2], value[3]);
+}
+
+void uniforms(GLuint program, unsigned sample) noexcept {
+    const char* ints[] = {"MaterialFeatures", "Kind", "TextureMask", "ColorTextureSrgbMask",
+                         "AlphaMode", "OutlinePass", "OutlineMode", "FramebufferSrgb"};
+    for (const char* name : ints) {
+        const GLint location = GLES.glGetUniformLocation(program, name);
+        if (location < 0) continue;
+        GLint value[16] = {};
+        GLES.glGetUniformiv(program, location, value);
+        record("[MG-VRM] sample=%u uniform=%s i=%d", sample, name, value[0]);
+    }
+    const char* floats[] = {"BaseColor", "LightIntensity", "Opacity", "AlphaCutoff",
+                           "OutlineWidth", "FogStart", "FogEnd", "LightDir", "FogColor", "ShadeColor",
+                           "UvScroll", "UvRotation", "TimeSeconds", "ShadingShift", "Toony", "GiEqualization"};
+    for (const char* name : floats) {
+        float_uniform(program, name, sample);
+    }
+}
+
+bool signature(draw_signature& key) noexcept {
+    const GLint program = integer(GL_CURRENT_PROGRAM);
+    if (program <= 0) return false;
+    GLint linked = GL_FALSE;
+    GLES.glGetProgramiv(program, GL_LINK_STATUS, &linked);
+    if (!linked || GLES.glGetUniformLocation(program, "MaterialFeatures") < 0 ||
+        GLES.glGetUniformLocation(program, "TextureMask") < 0 ||
+        GLES.glGetUniformLocation(program, "OutlinePass") < 0) return false;
+    key.program = program;
+    key.vao = integer(GL_VERTEX_ARRAY_BINDING);
+    const char* names[] = {"MaterialFeatures", "Kind", "TextureMask", "ColorTextureSrgbMask",
+                           "AlphaMode", "OutlinePass", "OutlineMode", "FramebufferSrgb"};
+    for (unsigned i = 0; i < key.modes.size(); ++i) key.modes[i] = uniform_int(program, names[i]);
+    unsigned color = 0;
+    for (const char* name : {"BaseColor", "ShadeColor"}) {
+        const GLint location = GLES.glGetUniformLocation(program, name);
+        GLfloat value[16] = {};
+        if (location >= 0) GLES.glGetUniformfv(program, location, value);
+        const unsigned n = color == 0 ? 4 : 3;
+        for (unsigned i = 0; i < n; ++i) std::memcpy(&key.colors[color++], &value[i], sizeof(uint32_t));
+    }
+    const GLint units = integer(GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS);
+    active_texture_scope restore;
+    key.units.fill(-1);
+    for (unsigned i = 0; i < 11; ++i) {
+        if ((key.modes[2] & (1 << i)) == 0) continue;
+        char name[24];
+        std::snprintf(name, sizeof(name), "Texture%u", i);
+        const GLint unit = uniform_int(program, name, -1);
+        key.units[i] = unit;
+        if (unit < 0 || unit >= units) continue;
+        GLES.glActiveTexture(GL_TEXTURE0 + unit);
+        key.textures[i] = integer(GL_TEXTURE_BINDING_2D);
+        key.samplers[i] = integer(GL_SAMPLER_BINDING);
+    }
+    return true;
+}
+
+void textures(const draw_signature& key, unsigned sample, bool level_queries) noexcept {
+    active_texture_scope restore;
+    GLint max_level = 0;
+    for (GLint size = integer(GL_MAX_TEXTURE_SIZE); size > 1; size >>= 1) ++max_level;
+    const GLint units = integer(GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS);
+    for (unsigned i = 0; i < 11; ++i) {
+        if ((key.modes[2] & (1 << i)) == 0) continue;
+        char name[32];
+        std::snprintf(name, sizeof(name), "UvTransform[%u]", i);
+        float_uniform(key.program, name, sample);
+        std::snprintf(name, sizeof(name), "UvAngle[%u]", i);
+        float_uniform(key.program, name, sample);
+        std::snprintf(name, sizeof(name), "UvSet[%u]", i);
+        record("[MG-VRM] sample=%u uniform=%s i=%d", sample, name, uniform_int(key.program, name, -1));
+        const GLint unit = key.units[i];
+        if (unit < 0 || unit >= units) {
+            record("[MG-VRM] sample=%u textureSlot=%u invalidUnit=%d", sample, i, unit);
+            continue;
+        }
+        GLES.glActiveTexture(GL_TEXTURE0 + unit);
+        const GLint texture = key.textures[i], sampler = key.samplers[i];
+        GLint base = -1, top = -1, filter = -1, sampler_filter = -1;
+        GLfloat min_lod = 0, max_lod = 0, sampler_min_lod = 0, sampler_max_lod = 0;
+        if (texture != 0) {
+            GLES.glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_BASE_LEVEL, &base);
+            GLES.glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, &top);
+            GLES.glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &filter);
+            GLES.glGetTexParameterfv(GL_TEXTURE_2D, GL_TEXTURE_MIN_LOD, &min_lod);
+            GLES.glGetTexParameterfv(GL_TEXTURE_2D, GL_TEXTURE_MAX_LOD, &max_lod);
+        }
+        if (sampler != 0) {
+            GLES.glGetSamplerParameteriv(sampler, GL_TEXTURE_MIN_FILTER, &sampler_filter);
+            GLES.glGetSamplerParameterfv(sampler, GL_TEXTURE_MIN_LOD, &sampler_min_lod);
+            GLES.glGetSamplerParameterfv(sampler, GL_TEXTURE_MAX_LOD, &sampler_max_lod);
+        }
+        record("[MG-VRM] sample=%u textureSlot=%u unit=%d texture=%d sampler=%d levels=%d..%d filter=0x%x samplerFilter=0x%x lod=%g..%g samplerLod=%g..%g",
+               sample, i, unit, texture, sampler, base, top, filter, sampler_filter,
+               min_lod, max_lod, sampler_min_lod, sampler_max_lod);
+        if (!texture || !level_queries || !GLES.glGetTexLevelParameteriv) continue;
+        std::array<bool, 32> visited{};
+        auto level = [&](GLint mip) {
+            if (mip < 0 || mip > max_level || mip >= static_cast<GLint>(visited.size()) || visited[mip]) return 0;
+            visited[mip] = true;
+            GLint width = 0, height = 0, format = 0;
+            GLES.glGetTexLevelParameteriv(GL_TEXTURE_2D, mip, GL_TEXTURE_WIDTH, &width);
+            GLES.glGetTexLevelParameteriv(GL_TEXTURE_2D, mip, GL_TEXTURE_HEIGHT, &height);
+            GLES.glGetTexLevelParameteriv(GL_TEXTURE_2D, mip, GL_TEXTURE_INTERNAL_FORMAT, &format);
+            record("[MG-VRM] sample=%u textureSlot=%u mip=%d size=%dx%d format=0x%x", sample, i, mip, width, height, format);
+            return std::max(width, height);
+        };
+        const GLint zero_size = level(0);
+        const GLint base_size = base == 0 ? zero_size : level(base);
+        GLint end = base;
+        for (GLint size = base_size; size > 1; size >>= 1) ++end;
+        end = std::min({end, top, max_level});
+        level(1);
+        for (GLint mip = std::max(base, 0); mip <= end && !stopped.load(std::memory_order_relaxed); ++mip) level(mip);
+    }
+}
+
+void attributes(unsigned sample) noexcept {
+    copy_read_scope restore;
+    const GLint max_attributes = integer(GL_MAX_VERTEX_ATTRIBS);
+    for (GLuint i = 0; i < 6 && static_cast<GLint>(i) < max_attributes; ++i) {
+        GLint active = 0, buffer = 0, stride = 0, size = 0, type = 0, normalized = 0, divisor = 0, integral = 0;
+        void* offset = nullptr;
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &active);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &buffer);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &stride);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_SIZE, &size);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_TYPE, &type);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &normalized);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_INTEGER, &integral);
+        GLES.glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_DIVISOR, &divisor);
+        GLES.glGetVertexAttribPointerv(i, GL_VERTEX_ATTRIB_ARRAY_POINTER, &offset);
+        GLint64 bytes = -1;
+        if (buffer > 0 && GLES.glIsBuffer(buffer)) {
+            GLES.glBindBuffer(GL_COPY_READ_BUFFER, buffer);
+            GLES.glGetBufferParameteri64v(GL_COPY_READ_BUFFER, GL_BUFFER_SIZE, &bytes);
+        }
+        record("[MG-VRM] sample=%u attribute=%u enabled=%d buffer=%d bytes=%lld offset=%llu stride=%d size=%d type=0x%x normalized=%d integer=%d divisor=%d",
+               sample, i, active, buffer, static_cast<long long>(bytes),
+               static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(offset)), stride, size, type, normalized, integral, divisor);
+    }
+}
+
+void capture(GLenum mode, GLsizei count, GLenum type, const draw_signature& key, unsigned sample) noexcept {
+    const GLuint program = key.program;
+    mg_framebuffer_snapshot logical{};
+    mg_get_framebuffer_snapshot(&logical);
+    const GLint fbo = integer(GL_DRAW_FRAMEBUFFER_BINDING);
+    const GLint major = integer(GL_MAJOR_VERSION), minor = integer(GL_MINOR_VERSION);
+    const bool level_queries = major > 3 || (major == 3 && minor >= 1);
+    const bool indexed_blend = major > 3 || (major == 3 && minor >= 2);
+    GLint viewport[4] = {};
+    GLES.glGetIntegerv(GL_VIEWPORT, viewport);
+    record("[MG-VRM] sample=%u ctx=%llu program=%u vao=%u mode=0x%x count=%d type=0x%x logicalFbo=%u driverFbo=%d viewport=%d,%d,%d,%d es=%d.%d",
+          sample, g_current_ctx->id, program, key.vao, mode, count, type,
+          logical.draw_fbo, fbo, viewport[0], viewport[1], viewport[2], viewport[3], major, minor);
+    uniforms(program, sample);
+    const bool srgb_control = g_gles_caps.GL_EXT_sRGB_write_control != 0;
+    record("[MG-VRM] sample=%u framebufferSrgbLogical=%d srgbWriteControl=%d framebufferSrgbDriver=%d",
+          sample, mg_enable_get(GL_FRAMEBUFFER_SRGB, 0), srgb_control,
+          srgb_control ? GLES.glIsEnabled(GL_FRAMEBUFFER_SRGB) : -1);
+    const GLint max_draw = integer(GL_MAX_DRAW_BUFFERS);
+    for (unsigned i = 0; i < 4 && static_cast<GLint>(i) < max_draw; ++i) {
+        const GLint buffer = integer(GL_DRAW_BUFFER0 + i);
+        GLint object_type = GL_NONE, object = 0, encoding = 0;
+        if (buffer != GL_NONE) {
+            GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, buffer,
+                GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &object_type);
+            if (object_type != GL_NONE) {
+                GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, buffer,
+                    GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+                if (fbo != 0) GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, buffer,
+                    GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &object);
+            }
+        }
+        record("[MG-VRM] sample=%u output=%u logical=0x%x driver=0x%x logicalCAiPhysical=0x%x objectType=0x%x object=%d encoding=0x%x",
+              sample, i, logical.draw_buffers[i], buffer, logical.color_attachments[i], object_type, object, encoding);
+        if (indexed_blend && GLES.glIsEnabledi && GLES.glGetIntegeri_v && GLES.glGetBooleani_v) {
+            GLint src = 0, dst = 0, equation = 0;
+            GLboolean mask[4] = {};
+            GLES.glGetIntegeri_v(GL_BLEND_SRC_RGB, i, &src);
+            GLES.glGetIntegeri_v(GL_BLEND_DST_RGB, i, &dst);
+            GLES.glGetIntegeri_v(GL_BLEND_EQUATION_RGB, i, &equation);
+            GLES.glGetBooleani_v(GL_COLOR_WRITEMASK, i, mask);
+            record("[MG-VRM] sample=%u output=%u blend=%d src=0x%x dst=0x%x equation=0x%x colorMask=%d,%d,%d,%d",
+                  sample, i, GLES.glIsEnabledi(GL_BLEND, i), src, dst, equation, mask[0], mask[1], mask[2], mask[3]);
+        }
+    }
+    textures(key, sample, level_queries);
+    record("[MG-VRM] sample=%u vao=%d ibo=%d depth=%d depthFunc=0x%x cull=%d cullMode=0x%x frontFace=0x%x blendGlobal=%d",
+          sample, integer(GL_VERTEX_ARRAY_BINDING), integer(GL_ELEMENT_ARRAY_BUFFER_BINDING),
+          GLES.glIsEnabled(GL_DEPTH_TEST), integer(GL_DEPTH_FUNC), GLES.glIsEnabled(GL_CULL_FACE),
+          integer(GL_CULL_FACE_MODE), integer(GL_FRONT_FACE), GLES.glIsEnabled(GL_BLEND));
+    attributes(sample);
+}
+}
+
+void mg_vrm_diagnostic(GLenum mode, GLsizei count, GLenum type) noexcept {
+    if (!enabled() || stopped.load(std::memory_order_relaxed) || !g_current_ctx) return;
