+        !multiply(row_stride, unpack_[2], temporary) || !add(start, temporary, start) ||
+        !multiply(input_size, unpack_[3], temporary) || !add(start, temporary, start) ||
+        !multiply(image_stride, depth - 1, temporary) || !add(start, temporary, span) ||
+        !multiply(row_stride, height - 1, temporary) || !add(span, temporary, span) ||
+        !multiply(input_size, width, temporary) || !add(span, temporary, span) ||
+        !multiply(width, height, size) || !multiply(size, depth, size) || !multiply(size, output_size, size)) {
+        fail(GL_INVALID_VALUE); return;
+    }
+    if (span > static_cast<size_t>(std::numeric_limits<GLsizeiptr>::max())) { fail(GL_INVALID_OPERATION); return; }
+    const uintptr_t address = reinterpret_cast<uintptr_t>(source);
+    if (address > std::numeric_limits<uintptr_t>::max() - span) { fail(GL_INVALID_OPERATION); return; }
+    if (unpack_buffer_ != 0) {
+        GLint mapped = 0, access = 0;
+        GLint64 capacity = 0;
+        GLES.glGetBufferParameteriv(GL_PIXEL_UNPACK_BUFFER, GL_BUFFER_MAPPED, &mapped);
+        if (mapped) GLES.glGetBufferParameteriv(GL_PIXEL_UNPACK_BUFFER, GL_BUFFER_ACCESS_FLAGS, &access);
+        GLES.glGetBufferParameteri64v(GL_PIXEL_UNPACK_BUFFER, GL_BUFFER_SIZE, &capacity);
+        if ((mapped && !(access & GL_MAP_PERSISTENT_BIT)) || capacity < 0 || address % input_size || address > static_cast<uint64_t>(capacity) ||
+            span > static_cast<uint64_t>(capacity) - address) { fail(GL_INVALID_OPERATION); return; }
+    }
+    try { data_.resize(size); }
+    catch (const std::bad_alloc&) { fail(GL_OUT_OF_MEMORY); return; }
+    catch (const std::length_error&) { fail(GL_OUT_OF_MEMORY); return; }
+    const uint8_t* input = static_cast<const uint8_t*>(source);
+    if (unpack_buffer_ != 0) {
+        GLES.glGetIntegerv(GL_COPY_WRITE_BUFFER_BINDING, &copy_write_);
+        GLES.glGenBuffers(1, &scratch_buffer_);
+        if (!scratch_buffer_) { fail(GL_OUT_OF_MEMORY); return; }
+        GLES.glBindBuffer(GL_COPY_WRITE_BUFFER, scratch_buffer_);
+        GLES.glBufferData(GL_COPY_WRITE_BUFFER, static_cast<GLsizeiptr>(span), nullptr, GL_STREAM_READ);
+        GLint64 allocated = 0;
+        GLES.glGetBufferParameteri64v(GL_COPY_WRITE_BUFFER, GL_BUFFER_SIZE, &allocated);
+        if (allocated != static_cast<GLint64>(span)) { fail(GL_OUT_OF_MEMORY); return; }
