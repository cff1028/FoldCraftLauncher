+// Modified for FCL Quest VR on 2026-11-13: strict error diagnostics take precedence.
+// Copyright (c) 2026 FCL Quest contributors
+// SPDX-License-Identifier: LGPL-2.1-only
+#include "backend_diagnostics.h"
+#include "log.h"
+#include "../gles/loader.h"
+#include "../egl/context.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#define DEBUG 0
+
+namespace {
+constexpr unsigned draw_limit = 256, blit_limit = 128, error_limit = 128, depth_limit = 64;
+std::atomic<bool> armed{false};
+std::atomic<unsigned> draw_count{0}, blit_count{0}, error_count{0};
+std::atomic<unsigned> depth_count{0}, depth_error_count{0};
+
+bool enabled() noexcept {
+    static const bool value = [] {
+        const char* setting = std::getenv("MG_BACKEND_DIAGNOSTICS");
+        return setting && std::strcmp(setting, "1") == 0 && !mg_strict_errors_enabled();
+    }();
+    return value;
+}
+
+unsigned claim(std::atomic<unsigned>& counter, unsigned limit) noexcept {
+    unsigned value = counter.load(std::memory_order_relaxed);
+    while (value < limit) {
+        if (counter.compare_exchange_weak(value, value + 1, std::memory_order_relaxed)) return value + 1;
+    }
+    return 0;
+}
+
+unsigned drain(GLenum (&errors)[8]) noexcept {
+    unsigned count = 0;
+    while (count < 8) {
+        const GLenum error = GLES.glGetError();
+        if (error == GL_NO_ERROR) break;
+        errors[count++] = error;
+    }
+    return count;
+}
+
+void format_errors(const GLenum* errors, unsigned count, char (&text)[96]) noexcept {
+    size_t used = 0;
+    text[0] = '\0';
+    if (count == 0) {
+        std::snprintf(text, sizeof(text), "none");
+        return;
+    }
+    for (unsigned i = 0; i < count; ++i) {
+        const int n = std::snprintf(text + used, sizeof(text) - used, "%s0x%x", i ? "," : "", errors[i]);
+        if (n < 0 || static_cast<size_t>(n) >= sizeof(text) - used) break;
+        used += static_cast<size_t>(n);
+    }
+    if (count == 8) std::snprintf(text + used, sizeof(text) - used, ",bounded");
+}
+
+struct probe_errors {
+    GLenum values[8] = {};
+    unsigned count = 0;
+    bool capture() noexcept {
+        GLenum current[8];
+        const unsigned n = drain(current);
+        for (unsigned i = 0; i < n && count < 8; ++i) values[count++] = current[i];
+        return n == 0;
+    }
+};
+
+struct attachment_info {
+    GLint type = -1, name = -1, level = -1, layer = -1, face = -1, target = -1;
+    GLint format = -1, width = -1, height = -1, layers = -1, samples = -1;
+    GLint depth_bits = -1, stencil_bits = -1, component_type = -1;
+};
+
+void texture_info(attachment_info& info, GLint minor, probe_errors& probe, probe_errors& target_probe) noexcept {
+    if (!GLES.glIsTexture || !GLES.glBindTexture || !GLES.glGetTexLevelParameteriv) return;
+    const bool exists = GLES.glIsTexture(static_cast<GLuint>(info.name));
+    if (!probe.capture() || !exists) return;
+    struct candidate { GLenum target, binding; GLint minor; };
+    const candidate targets[] = {
+        {GL_TEXTURE_2D, GL_TEXTURE_BINDING_2D, 0},
+        {GL_TEXTURE_CUBE_MAP, GL_TEXTURE_BINDING_CUBE_MAP, 0},
+        {GL_TEXTURE_2D_ARRAY, GL_TEXTURE_BINDING_2D_ARRAY, 0},
+        {GL_TEXTURE_3D, GL_TEXTURE_BINDING_3D, 0},
+        {GL_TEXTURE_2D_MULTISAMPLE, GL_TEXTURE_BINDING_2D_MULTISAMPLE, 1},
+        {GL_TEXTURE_2D_MULTISAMPLE_ARRAY, GL_TEXTURE_BINDING_2D_MULTISAMPLE_ARRAY, 2},
+        {GL_TEXTURE_CUBE_MAP_ARRAY, GL_TEXTURE_BINDING_CUBE_MAP_ARRAY, 2}
+    };
+    for (const auto& candidate : targets) {
+        if (candidate.minor > minor || (info.face > 0 && candidate.target != GL_TEXTURE_CUBE_MAP)) continue;
+        GLint saved = -1;
+        GLES.glGetIntegerv(candidate.binding, &saved);
+        if (!probe.capture() || saved < 0) continue;
+        // Existing objects reject a different target without changing their type.
+        GLES.glBindTexture(candidate.target, static_cast<GLuint>(info.name));
+        const bool bound = target_probe.capture();
+        if (bound) {
+            info.target = static_cast<GLint>(candidate.target);
+            const GLenum query_target = candidate.target == GL_TEXTURE_CUBE_MAP
+                ? (info.face > 0 ? static_cast<GLenum>(info.face) : GL_TEXTURE_CUBE_MAP_POSITIVE_X) : candidate.target;
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_INTERNAL_FORMAT, &info.format);
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_WIDTH, &info.width);
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_HEIGHT, &info.height);
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_DEPTH, &info.layers);
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_SAMPLES, &info.samples);
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_DEPTH_SIZE, &info.depth_bits);
+            GLES.glGetTexLevelParameteriv(query_target, info.level, GL_TEXTURE_STENCIL_SIZE, &info.stencil_bits);
+            probe.capture();
+        }
+        GLES.glBindTexture(candidate.target, static_cast<GLuint>(saved));
+        probe.capture();
+        if (bound) break;
+    }
+}
+
+attachment_info attachment(GLenum target, GLint fbo, GLenum point, GLint minor,
+                           probe_errors& probe, probe_errors& target_probe) noexcept {
+    attachment_info info;
+    if (fbo < 0 || !GLES.glGetFramebufferAttachmentParameteriv) return info;
+    const GLenum query_point = fbo == 0 ? (point == GL_DEPTH_ATTACHMENT ? GL_DEPTH : GL_STENCIL) : point;
+    GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &info.type);
+    if (!probe.capture() || info.type == GL_NONE) return info;
+    GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_DEPTH_SIZE, &info.depth_bits);
+    GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_STENCIL_SIZE, &info.stencil_bits);
+    GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE, &info.component_type);
+    if (fbo == 0) {
+        probe.capture();
+        return info;
+    }
+    GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &info.name);
+    if (!probe.capture()) return info;
+    if (info.type == GL_TEXTURE) {
+        GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LEVEL, &info.level);
+        GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LAYER, &info.layer);
+        GLES.glGetFramebufferAttachmentParameteriv(target, query_point, GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_CUBE_MAP_FACE, &info.face);
+        if (probe.capture()) texture_info(info, minor, probe, target_probe);
+    } else if (info.type == GL_RENDERBUFFER && GLES.glIsRenderbuffer && GLES.glBindRenderbuffer && GLES.glGetRenderbufferParameteriv) {
+        const bool exists = GLES.glIsRenderbuffer(static_cast<GLuint>(info.name));
+        if (!probe.capture() || !exists) return info;
+        GLint saved = -1;
+        GLES.glGetIntegerv(GL_RENDERBUFFER_BINDING, &saved);
+        if (!probe.capture() || saved < 0) return info;
+        GLES.glBindRenderbuffer(GL_RENDERBUFFER, static_cast<GLuint>(info.name));
+        if (probe.capture()) {
+            info.target = GL_RENDERBUFFER;
+            GLES.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_INTERNAL_FORMAT, &info.format);
+            GLES.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_WIDTH, &info.width);
+            GLES.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_HEIGHT, &info.height);
+            GLES.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_DEPTH_SIZE, &info.depth_bits);
+            GLES.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_STENCIL_SIZE, &info.stencil_bits);
+            GLES.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_SAMPLES, &info.samples);
+            probe.capture();
+        }
+        GLES.glBindRenderbuffer(GL_RENDERBUFFER, static_cast<GLuint>(saved));
+        probe.capture();
+    }
+    return info;
+}
+
+void describe(const attachment_info& value, char (&text)[384]) noexcept {
+    std::snprintf(text, sizeof(text), "type=0x%x name=%d target=0x%x level=%d layer=%d face=0x%x format=0x%x size=%dx%dx%d depth=%d stencil=%d component=0x%x samples=%d",
+                  value.type, value.name, value.target, value.level, value.layer, value.face, value.format,
+                  value.width, value.height, value.layers, value.depth_bits, value.stencil_bits, value.component_type, value.samples);
+}
+}
+
+void mg_backend_diag_arm() noexcept {
+    if (!enabled() || armed.exchange(true, std::memory_order_relaxed)) return;
+    LOG_W_FORCE("[MG-BACKEND] depth-range trigger: detailed draws=%u colorBlits=%u; depth/stencil success=%u failure=%u independent; raw error reads consume driver errors; diagnostic use only",
+                draw_limit, blit_limit, depth_limit, depth_limit);
+}
+
+mg_backend_diagnostic::mg_backend_diagnostic(mg_backend_diag_kind kind, const char* operation,
+                                            GLenum mode, GLsizei count, GLenum type) noexcept {
+    if (!enabled() || !GLES.glGetError) return;
+    kind_ = kind;
+    operation_ = operation;
+    mode_ = mode;
+    count_ = count;
+    type_ = type;
+    slot_ = 0;
+    depth_copy_ = kind == mg_backend_diag_kind::blit && (mode & (GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT)) != 0;
+    error_slot_ = 0;
+    if (depth_copy_) {
+        slot_ = claim(depth_count, depth_limit);
+        depth_error_slot_ = claim(depth_error_count, depth_limit);
+    } else if (armed.load(std::memory_order_relaxed)) {
+        slot_ = kind == mg_backend_diag_kind::draw ? claim(draw_count, draw_limit) : claim(blit_count, blit_limit);
+    }
+    detailed_ = slot_ != 0;
+    if (!depth_copy_ && !detailed_) error_slot_ = claim(error_count, error_limit);
+    if (!detailed_ && !error_slot_ && !depth_error_slot_) return;
+    active_ = true;
+    // Keep pre-existing and operation errors separate; neither uses the shader error channel.
+    prior_count_ = drain(prior_);
+}
+
+void mg_backend_diagnostic::set_blit_region(GLint sx0, GLint sy0, GLint sx1, GLint sy1,
+                                           GLint dx0, GLint dy0, GLint dx1, GLint dy1,
+                                           GLuint logical_read, GLuint logical_draw) noexcept {
+    if (!active_) return;
+    const GLint values[] = {sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1};
+    for (unsigned i = 0; i < 8; ++i) rectangle_[i] = values[i];
+    logical_read_ = logical_read;
+    logical_draw_ = logical_draw;
+}
+
+void mg_backend_diagnostic::finish() noexcept {
+    if (!active_) return;
+    active_ = false;
+    GLenum after[8];
+    const unsigned after_count = drain(after);
+    const bool failed = prior_count_ != 0 || after_count != 0;
+    if (depth_copy_) {
+        if (after_count != 0) {
+            if (slot_) depth_count.fetch_sub(1, std::memory_order_relaxed);
+            if (!depth_error_slot_) return;
+            slot_ = depth_error_slot_;
+        } else {
+            if (depth_error_slot_) depth_error_count.fetch_sub(1, std::memory_order_relaxed);
+            if (!slot_) return;
+        }
+    } else if (!detailed_) {
+        if (!failed) {
+            error_count.fetch_sub(1, std::memory_order_relaxed);
+            return;
+        }
+    }
+    char before_text[96], after_text[96], probe_text[96];
+    format_errors(prior_, prior_count_, before_text);
+    format_errors(after, after_count, after_text);
+
+    if (depth_copy_) {
+        probe_errors probe, target_probe;
+        GLint draw = -1, read = -1, draw_samples = -1, read_samples = -1, minor = -1;
+        GLint active_texture = -1;
+        GLenum draw_status = 0, read_status = 0;
+        attachment_info rd, rs, dd, ds;
+        if (GLES.glGetIntegerv && GLES.glCheckFramebufferStatus) {
+            GLES.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+            GLES.glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+            GLES.glGetIntegerv(GL_MINOR_VERSION, &minor);
+            GLES.glGetIntegerv(GL_ACTIVE_TEXTURE, &active_texture);
+            GLES.glGetIntegerv(GL_SAMPLES, &draw_samples);
+            draw_status = GLES.glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+            read_status = GLES.glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+            probe.capture();
+            if (read == draw) read_samples = draw_samples;
+            else if (read >= 0 && draw >= 0 && GLES.glBindFramebuffer) {
+                GLES.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(read));
+                if (probe.capture()) GLES.glGetIntegerv(GL_SAMPLES, &read_samples);
+                probe.capture();
+                GLES.glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(draw));
+                probe.capture();
+            }
+            rd = attachment(GL_READ_FRAMEBUFFER, read, GL_DEPTH_ATTACHMENT, minor, probe, target_probe);
+            rs = attachment(GL_READ_FRAMEBUFFER, read, GL_STENCIL_ATTACHMENT, minor, probe, target_probe);
+            dd = attachment(GL_DRAW_FRAMEBUFFER, draw, GL_DEPTH_ATTACHMENT, minor, probe, target_probe);
+            ds = attachment(GL_DRAW_FRAMEBUFFER, draw, GL_STENCIL_ATTACHMENT, minor, probe, target_probe);
+        }
+        probe.capture();
+        char rd_text[384], rs_text[384], dd_text[384], ds_text[384], target_text[96];
+        describe(rd, rd_text); describe(rs, rs_text); describe(dd, dd_text); describe(ds, ds_text);
+        format_errors(probe.values, probe.count, probe_text);
+        format_errors(target_probe.values, target_probe.count, target_text);
+        LOG_W_FORCE("[MG-DEPTH-BLIT] ctx=%llu result=%s detail=%u/%u mask=0x%x filter=0x%x src=%d,%d,%d,%d dst=%d,%d,%d,%d "
+                    "logical(read=%u draw=%u) driver(read=%d draw=%d status=0x%x/0x%x samples=%d/%d activeTexture=0x%x) "
+                    "prior=[%s] call=[%s] probe=[%s] targetProbe=[%s] "
+                    "readDepth={%s} readStencil={%s} drawDepth={%s} drawStencil={%s}",
+                    g_current_ctx ? g_current_ctx->id : 0ULL, after_count ? "failed" : "ok", slot_, depth_limit, mode_, type_,
+                    rectangle_[0], rectangle_[1], rectangle_[2], rectangle_[3], rectangle_[4], rectangle_[5], rectangle_[6], rectangle_[7],
+                    logical_read_, logical_draw_, read, draw, read_status, draw_status, read_samples, draw_samples, active_texture,
+                    before_text, after_text, probe_text, target_text, rd_text, rs_text, dd_text, ds_text);
+        return;
+    }
+
+    GLint draw_fbo = -1, read_fbo = -1, vao = -1, ibo = -1, vbo = -1, program = -1, depth_func = -1;
+    GLint viewport[4] = {}, scissor[4] = {};
+    GLfloat depth_range[2] = {};
+    GLboolean depth_test = 0, depth_write = 0, scissor_test = 0, cull = 0, blend = 0;
+    GLenum draw_status = 0, read_status = 0;
+    const bool state_available = GLES.glGetIntegerv && GLES.glGetFloatv && GLES.glGetBooleanv && GLES.glCheckFramebufferStatus;
+    if (state_available) {
+        GLES.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fbo);
+        GLES.glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+        GLES.glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+        GLES.glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &ibo);
+        GLES.glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &vbo);
+        GLES.glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+        GLES.glGetIntegerv(GL_VIEWPORT, viewport);
+        GLES.glGetIntegerv(GL_SCISSOR_BOX, scissor);
+        GLES.glGetIntegerv(GL_DEPTH_FUNC, &depth_func);
+        GLES.glGetFloatv(GL_DEPTH_RANGE, depth_range);
+        GLES.glGetBooleanv(GL_DEPTH_TEST, &depth_test);
+        GLES.glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+        GLES.glGetBooleanv(GL_SCISSOR_TEST, &scissor_test);
+        GLES.glGetBooleanv(GL_CULL_FACE, &cull);
+        GLES.glGetBooleanv(GL_BLEND, &blend);
+        draw_status = GLES.glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+        read_status = GLES.glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+    }
+    GLenum probe[8];
+    const unsigned probe_count = drain(probe);
+    format_errors(probe, probe_count, probe_text);
+    LOG_W_FORCE("[MG-BACKEND] op=%s ctx=%llu detail=%u/%u error=%u/%u modeOrMask=0x%x count=%d typeOrFilter=0x%x "
+                "prior=[%s] call=[%s] probe=[%s] state=%d driver(drawFbo=%d readFbo=%d status=0x%x/0x%x vao=%d ibo=%d vbo=%d program=%d) "
+                "viewport=%d,%d,%d,%d scissor=%u:%d,%d,%d,%d depth=%u:%u:0x%x:[%.9g,%.9g] cull=%u blend=%u",
+                operation_, g_current_ctx ? g_current_ctx->id : 0ULL, slot_,
+                kind_ == mg_backend_diag_kind::draw ? draw_limit : blit_limit, error_slot_, error_limit,
+                mode_, count_, type_, before_text, after_text, probe_text, state_available ? 1 : 0,
+                draw_fbo, read_fbo, draw_status, read_status, vao, ibo, vbo, program,
+                viewport[0], viewport[1], viewport[2], viewport[3], scissor_test,
+                scissor[0], scissor[1], scissor[2], scissor[3], depth_test, depth_write, depth_func,
+                depth_range[0], depth_range[1], cull, blend);
+}
