<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_vr_render_scale">VR 渲染比例</string>
    <string name="settings_vr_render_scale_desc">相对于 OpenXR 推荐分辨率的像素总量。100% 为推荐值，越高越清晰，也越耗性能。修改后下次启动游戏生效。</string>
    <string name="settings_vr_render_scale_range">请输入 10–900 的整数（百分比）</string>
    <string name="settings_vr_fsaa">FSAA 抗锯齿</string>
    <string name="settings_vr_fsaa_desc">启用 Vivecraft 的 Lanczos 缩放滤波，可配合高于 100% 的渲染比例使用。会增加渲染开销，修改后下次启动游戏生效。</string>
    <string name="settings_vr_graphics_loading">读取中…</string>
    <string name="settings_quest_vr_transition_animation">Quest VR 切换过渡动画</string>
    <string name="settings_quest_vr_transition_animation_desc">切换平面与 VR 模式时淡入淡出。默认开启；修改后下次启动游戏生效。</string>
</resources>
